<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatClawVideo.Maui.Controls"
             x:Class="CatClawVideo.Maui.Pages.WatchPage"
             BackgroundColor="{DynamicResource WindowBackgroundColor}"
             NavigationPage.HasNavigationBar="False">

    <!-- 隐藏 Shell 系统返回键（页面自带自定义返回，避免左上角双返回按钮） -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <!-- ★ 2026-10-20 用户要求：把返回按钮放到**标题栏**上。
         结构改成两行：第 0 行 = 固定 48px 标题栏（不随内容滚动，返回键是交互控件、其余空白可拖），
         第 1 行 = 原来的滚动内容。拖拽矩形由 WatchPage.xaml.cs 按返回键位置"挖洞"声明。 -->
    <Grid RowDefinitions="56,*">
        <Grid x:Name="TopBarGrid" Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12"
              Padding="16,8,12,0" HeightRequest="56">
            <Border Grid.Column="0" x:Name="BackButtonHost" StrokeThickness="0" BackgroundColor="{DynamicResource ChipInactiveColor}"
                    StrokeShape="RoundRectangle 12" WidthRequest="38" HeightRequest="38" VerticalOptions="Center">
                <Image Source="ic_back.png" WidthRequest="18" HeightRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1" x:Name="TopBarTitle" Text="猫爪影视" FontSize="14.5" FontFamily="OpenSansSemibold"
                   LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center"
                   TextColor="{DynamicResource TextPrimaryColor}" />
        </Grid>

    <ScrollView x:Name="ContentScroll" Grid.Row="1">
        <VerticalStackLayout x:Name="ContentStack" Padding="24,6,24,28" Spacing="14">

            <!-- ═══ 线路行：右侧下拉框 = "切换线路"前缀 + 当前路线（17 条收进下拉） ═══ -->
            <Grid x:Name="RouteBar" ColumnDefinitions="*,Auto" ColumnSpacing="10"
                   Margin="0,2,0,0" VerticalOptions="Start">
                <BoxView x:Name="RouteBarSpacer" Grid.Column="0" Color="Transparent" />
                <Border x:Name="RoutePill" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{DynamicResource PrimaryColor}" Padding="14,6">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSwitchRouteClicked" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="切换线路" FontSize="12" TextColor="#BFD4FF" VerticalOptions="Center" />
                        <Label x:Name="CurrentRouteLabel" Text="—" FontSize="12" FontFamily="OpenSansSemibold"
                               TextColor="White" VerticalOptions="Center" />
                        <Label x:Name="RouteCountLabel" Text="" FontSize="11" TextColor="#BFD4FF" VerticalOptions="Center" />
                        <Label Text="▾" FontSize="12" TextColor="White" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- ═══ 主区：播放器 + 右侧选集栏（主流播放器形态；全屏模式下选集列隐藏） ═══ -->
            <Grid x:Name="MainArea" ColumnDefinitions="*,300" ColumnSpacing="16">
                <!-- Windows：与顶栏留出间距（顶栏即标题栏，播放框贴太近显得局促） -->
                <Grid.Margin>
                    <OnPlatform x:TypeArguments="Thickness">
                        <On Platform="WinUI" Value="0,14,0,0" />
                    </OnPlatform>
                </Grid.Margin>

                <!-- 播放器（16:9 高度随宽自适应）+ 线路芯片 + 控制条 -->
                <Border x:Name="PlayerFrame" Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="Black"
                        VerticalOptions="Start">
                    <Grid x:Name="PlayerHost" HeightRequest="340">
                        <controls:VideoPlayerView x:Name="Player"
                                                  Aspect="AspectFit"
                                                  ShouldKeepScreenOn="True" />

                        <!-- 弹幕浮层：播放器之上、控制条之下。InputTransparent，永不抢遥控器/触摸焦点 -->
                        <controls:DanmakuOverlay x:Name="Danmaku" InputTransparent="True" />

                        <!-- 左上角播放状态浮层（2026-10-18 用户要求）：显示**真实**数值 ——
                             源分辨率/源帧率，开插帧/超分后追加一行实际输出（estimated-vf-fps / osd-dimensions）。
                             刻意放在最后一个子元素（MAUI 后者在上）：mpv 渲染控件是运行时 Add 进来的，
                             不这样会被它盖住。显隐由 SyncStatsOverlay 跟底部控件同步。 -->
                        <Border x:Name="StatsOverlay" IsVisible="False" InputTransparent="True"
                                HorizontalOptions="Start" VerticalOptions="Start" Margin="10,10,0,0"
                                StrokeThickness="0" BackgroundColor="#99000000" Padding="8,5"
                                StrokeShape="RoundRectangle 8">
                            <Label x:Name="StatsOverlayText" TextColor="White" FontSize="12.5" LineHeight="1.25" />
                        </Border>

                        <!-- 缓冲指示：圆环进度 + 中央百分比（解析/时长未知时自动退化为旋转弧） -->
                        <Grid x:Name="BufferingIndicator" IsVisible="False">
                            <!-- 半透明底衬：深色画面上保证百分比可读（磁力/暗景常见） -->
                            <BoxView Color="#59000000" InputTransparent="True" />
                            <controls:BufferProgressView x:Name="BufferRing"
                                                         Diameter="64" />
                        </Grid>

                        <!-- 控制覆盖层：中央播放/暂停 + 底部进度 -->
                        <!-- BackgroundColor="Transparent" 不可省：WinUI 下 Background=null 的面板
                             不参与命中测试，指针进出/点击画面事件都会落空（视频控件在它下面） -->
                        <Grid x:Name="ControlsOverlay" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSurfaceTapped" />
                            </Grid.GestureRecognizers>

                            <!-- 倍速徽章：播放速率 ≠ 1.0 时常驻，右上角。
                                 （原为 BT 网速徽章，内置 BT 移除后网速已无数据源，改作倍速提示。） -->
                            <Border x:Name="SpeedBadge" IsVisible="False" InputTransparent="True"
                                    StrokeThickness="0" BackgroundColor="#80000000"
                                    StrokeShape="RoundRectangle 6" Padding="8,4"
                                    HorizontalOptions="End" VerticalOptions="Start" Margin="0,10,12,0">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="»" FontSize="12" TextColor="#FFD76E" VerticalOptions="Center" />
                                    <Label x:Name="SpeedLabel" Text="1.5× 播放" FontSize="11" TextColor="#FFD76E" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <ImageButton x:Name="CenterPlayButton"
                                         WidthRequest="56" HeightRequest="56"
                                         CornerRadius="28"
                                         BackgroundColor="#66000000"
                                         HorizontalOptions="Center" VerticalOptions="Center"
                                         Clicked="OnPlayPauseClicked" />
                            <!-- 控件条（方案 B · 悬浮双行面板，与全屏播放页共用同一控件） -->
                            <controls:PlaybackControlBar x:Name="ControlBar" />

                        </Grid>

                        <!-- ═══ 全屏选集浮层 ═══
                             ⚠ 放在 PlayerHost 内部（播放器之上、ControlsOverlay 之外），两个原因：
                               ① WinUI 的 MediaPlayerElement 是 DirectX 交换链（SwapChainPanel），会盖住
                                  其外部的同级/上层 MAUI 元素（airspace）——放页面级时浮层完全不显示；
                               ② 必须**放在 ControlsOverlay 之外**：该层带「点击画面切换控制层」手势
                                  且会被 3s 自动隐藏连带藏掉子元素，浮层放进去会两者都中招。
                             非全屏时选集栏常驻右列，本层不参与。 -->
                        <Grid x:Name="EpisodesOverlay" IsVisible="False">
                            <BoxView Color="#B3000000">
                                <BoxView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEpisodesOverlayBackdropTapped" />
                                </BoxView.GestureRecognizers>
                            </BoxView>

                            <Grid x:Name="EpisodesOverlayHost"
                                  WidthRequest="360"
                                  HorizontalOptions="End"
                                  VerticalOptions="Fill"
                                  Margin="0,10,10,10" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 右侧选集栏（与播放器等高，内部滚动；全屏模式下隐藏） -->
                <Border x:Name="SidebarPanel" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        VerticalOptions="Fill" MaximumHeightRequest="340" Padding="0">
                    <!-- ⚠️ MaximumHeightRequest 必须与 PlayerHost 一致：外层页面是垂直堆叠+
                         ScrollView，内部 ScrollView 在无界测量下会按全部集数把面板撑高，
                         造成选集框比播放框高出一大截（2026-09-11 真机实测）。 -->
                    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="14,12,14,0">
                            <Label Grid.Column="0" Text="选集" FontSize="14" FontFamily="OpenSansSemibold"
                                   TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="Center" />
                            <!-- 必须显式指定列：缺省落第 0 列会与「选集」标签重叠 -->
                            <Label x:Name="EpisodeCountLabel" Grid.Column="1" FontSize="11"
                                   TextColor="{DynamicResource TextHintColor}" VerticalOptions="Center" />
                        </Grid>

                        <ScrollView Grid.Row="1" x:Name="EpisodeScroll" Padding="10,4,10,4">
                            <!-- 一页 20 集（2 列 × 10 行），行内容代码后置填充 -->
                            <Grid x:Name="EpisodeListHost" ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="4" />
                        </ScrollView>

                        <!-- 翻页条：多于 1 页才显示；首页隐藏上一页、末页隐藏下一页（代码后置控制） -->
                        <HorizontalStackLayout Grid.Row="2" x:Name="EpisodePager" IsVisible="False"
                                               HorizontalOptions="Center" Spacing="10" Padding="0,6,0,10">
                            <Button x:Name="PagerPrev" Text="上一页" FontSize="12"
                                    ContentLayout="Left,4"
                                    ImageSource="ic_arrow_left_white.png"
                                    TextColor="{DynamicResource TextPrimaryColor}"
                                    BackgroundColor="{DynamicResource ChipInactiveColor}"
                                    CornerRadius="8" Padding="12,6" Clicked="OnPrevPageTapped" />
                            <Label x:Name="PagerLabel" FontSize="11"
                                   TextColor="{DynamicResource TextHintColor}" VerticalOptions="Center" />
                            <Button x:Name="PagerNext" Text="下一页" FontSize="12"
                                    ContentLayout="Right,4"
                                    ImageSource="ic_arrow_right_white.png"
                                    TextColor="{DynamicResource TextPrimaryColor}"
                                    BackgroundColor="{DynamicResource ChipInactiveColor}"
                                    CornerRadius="8" Padding="12,6" Clicked="OnNextPageTapped" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ 信息区（播放器下方全宽；全屏模式下隐藏） ═══ -->
            <Grid x:Name="InfoArea" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="0" Padding="0,2,0,0">
                <!-- 标题行：片名 + 徽章 + 操作 -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" x:Name="TitleLabel" FontSize="20" FontFamily="OpenSansSemibold"
                           LineBreakMode="TailTruncation" MaxLines="1"
                           TextColor="{DynamicResource TextPrimaryColor}" VerticalOptions="Center" />
                    <Border Grid.Column="1" x:Name="RemarksBadge" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource ChipInactiveColor}" Padding="8,3" IsVisible="False"
                            VerticalOptions="Center">
                        <Label x:Name="RemarksBadgeLabel" FontSize="11" TextColor="#FFD76E" />
                    </Border>
                    <Border Grid.Column="2" x:Name="YearBadge" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource ChipInactiveColor}" Padding="8,3" IsVisible="False"
                            VerticalOptions="Center">
                        <Label x:Name="YearBadgeLabel" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Border>
                    <Border Grid.Column="3" x:Name="CategoryBadge" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource ChipInactiveColor}" Padding="8,3" IsVisible="False"
                            VerticalOptions="Center">
                        <Label x:Name="CategoryBadgeLabel" FontSize="11" TextColor="{DynamicResource TextSecondaryColor}" />
                    </Border>
                    <!-- 换源：跨站点搜同名片，选中即切到该站点播放 -->
                    <Button Grid.Column="4" x:Name="SwitchSourceButton" Text="换源" FontSize="12.5"
                            ImageSource="ic_refresh_white.png" ContentLayout="Left,5"
                            HorizontalOptions="End" VerticalOptions="Center"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            BackgroundColor="{DynamicResource ChipInactiveColor}"
                            CornerRadius="8" Padding="14,7" Clicked="OnSwitchSourceClicked" />

                    <Button Grid.Column="5" x:Name="FavoriteButton" Text="收藏" FontSize="12.5"
                            ContentLayout="Left,5"
                            ImageSource="ic_favorite_border_white.png"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            BackgroundColor="{DynamicResource ChipInactiveColor}"
                            CornerRadius="8" Padding="14,7" Clicked="OnFavoriteClicked" />
                    <Button Grid.Column="6" x:Name="ShareButton" Text="分享" FontSize="12.5"
                            ContentLayout="Left,5"
                            ImageSource="ic_share_white.png"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            BackgroundColor="{DynamicResource ChipInactiveColor}"
                            CornerRadius="8" Padding="14,7" Clicked="OnShareClicked" />
                </Grid>

                <!-- 元数据行 -->
                <Label Grid.Row="1" x:Name="MetaLabel" FontSize="12" Margin="0,8,0,0"
                       TextColor="{DynamicResource TextHintColor}" />

                <!-- 简介（两行截断 + 展开） -->
                <Label Grid.Row="2" x:Name="DescLabel" FontSize="12.5" Margin="0,10,0,0"
                       LineBreakMode="WordWrap" MaxLines="2"
                       TextColor="{DynamicResource TextSecondaryColor}" />
                <Label Grid.Row="3" x:Name="DescToggle" Text="展开 ▾" FontSize="12"
                       TextColor="{DynamicResource PrimaryColor}" Margin="0,6,0,0" IsVisible="False">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDescToggleTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- 相关推荐占位（接入推荐接口后填充；全屏模式下隐藏） -->
            <Label x:Name="RecommendHint" Text="相关推荐随后续推荐接口上线" FontSize="11" Margin="0,14,0,0"
                   TextColor="{DynamicResource TextHintColor}" />

        </VerticalStackLayout>
    </ScrollView>

    <!-- ═══ 线路下拉悬浮层：与 ScrollView 同 Grid 单元叠放，不占文档流 ═══ -->
    <Grid x:Name="RouteOverlay" IsVisible="False" ZIndex="100">
        <BoxView Color="#80000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRouteOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="RouteDropdown" StrokeThickness="0"
                StrokeShape="RoundRectangle 10" BackgroundColor="{DynamicResource CardBackgroundColor}"
                Padding="8" HorizontalOptions="End" VerticalOptions="Start"
                Margin="0,110,24,0" WidthRequest="240">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.4" Radius="12" Offset="0,4" />
            </Border.Shadow>
            <ScrollView MaximumHeightRequest="360" VerticalScrollBarVisibility="Default">
                <VerticalStackLayout x:Name="RouteDropdownHost" Spacing="4" />
            </ScrollView>
        </Border>
    </Grid>
    </Grid>

</ContentPage>
